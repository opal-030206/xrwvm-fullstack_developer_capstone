# Cars Dealership - Flask sentiment analysis microservice
#
#   docker build -f Dockerfile.sentiment -t cars-dealership-sentiment .
#   docker run -p 5050:8080 cars-dealership-sentiment
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir Flask flask-cors gunicorn

COPY server/__init__.py ./server/__init__.py
COPY server/sentiment ./server/sentiment

EXPOSE 8080

CMD ["sh", "-c", "gunicorn server.sentiment.app:app --bind 0.0.0.0:${PORT} --workers 2 --timeout 60"]
